{
  "name": "keyboard-array",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint:policy": "node scripts/check-antipatterns.mjs",
    "check": "pnpm lint:policy && biome check --error-on-warnings .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
